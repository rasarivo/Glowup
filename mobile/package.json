{
  "name": "cap-micro-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Cap Micro — application iOS et Android (Capacitor) construite à partir de ../cap-micro.html",
  "type": "module",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "assets": "node scripts/render-assets.mjs && capacitor-assets generate --iconBackgroundColor '#0b1220' --iconBackgroundColorDark '#0b1220' --splashBackgroundColor '#0b1220' --splashBackgroundColorDark '#0b1220'",
    "sync": "npm run build:web && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios"
  },
  "dependencies": {
    "@babel/standalone": "^7.29.9",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "playwright": "^1.56.1",
    "sharp": "^0.35.4"
  }
}
